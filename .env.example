# Copy to .env and edit. Only the LEFT side of volume paths + these values change per host.
APP_PORT=8090
TZ=UTC
PUID=1000
PGID=1000

# Where your files live on the HOST (bind mount -> /data in container).
# CasaOS example: STORAGE_PATH=/DATA/Storage/Files
#                APPDATA_PATH=/DATA/AppData/vaultora
STORAGE_PATH=./storage
APPDATA_PATH=./appdata

APP_URL=http://localhost:8090
ADMIN_USER=admin
ADMIN_PASSWORD=changeme123
SESSION_TTL_HOURS=72
MAX_FILE_SIZE=21474836480
DEFAULT_QUOTA=
TRASH_RETENTION_DAYS=30
# Set to 1 when serving behind https (secure cookies):
COOKIE_SECURE=0
