{
  "name": "vaultora",
  "version": "1.0.0",
  "description": "Vaultora — private self-hosted web file storage for CasaOS/Docker homelab. Your server's storage, nothing else.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/app.test.js tests/extra.test.js",
    "test:e2e": "node scripts/run-e2e.cjs",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "migrate": "node src/db.js --migrate-only"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.0.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
